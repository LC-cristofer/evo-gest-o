# ============================================================
# ONG Sistema - Backend - Variáveis de Ambiente
# Copie para .env e preencha os valores
# ============================================================

NODE_ENV=development
PORT=4000

# ─── Banco de dados ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ong_sistema
DB_USER=postgres
DB_PASS=SUA_SENHA_AQUI
DB_SSL=false

# ─── JWT ────────────────────────────────────────────────────
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=gere_uma_chave_secreta_forte_aqui_64_bytes_minimo
JWT_REFRESH_SECRET=outra_chave_secreta_para_refresh_token_aqui
JWT_EXPIRES=8h

# ─── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.seudominio.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rh@seudominio.com.br
SMTP_PASS=senha_do_email
SMTP_FROM=rh@seudominio.com.br

# ─── Aplicação ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ORG_NAME=Nome da ONG
LOG_LEVEL=info

# ─── Redis (opcional, para blacklist de tokens) ───────────────
# REDIS_URL=redis://localhost:6379
